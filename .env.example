# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/agent_soul

# AI image generation (required)
REPLICATE_API_TOKEN=r8_...

# Solana network: "devnet" | "mainnet-beta" | "localhost"
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC (optional — falls back to public endpoints)
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=

# NFT minting authority (optional — minting disabled without this)
MINT_AUTHORITY_SECRET_KEY=
COLLECTION_MINT_ADDRESS=

# Vercel Blob storage for NFT metadata (optional — uses inline JSON URIs without this)
BLOB_READ_WRITE_TOKEN=

# x402 payment gate (optional — payment check skipped without both)
FACILITATOR_URL=
MERCHANT_SOLANA_ADDRESS=

# Admin panel (optional — admin routes disabled without this)
JWT_SECRET=

# Public app URL used in metadata, sitemap, robots.txt (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NFT defaults (optional)
NFT_SYMBOL=AART
ROYALTY_BASIS_POINTS=500
